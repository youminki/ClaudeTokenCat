{
  "name": "tokencat-leaderboard",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // 매일 한 번 오래된 판과 제출 횟수 기록을 지운다
  "triggers": { "crons": ["17 3 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tokencat-leaderboard",
      // deploy.sh가 처음 배포할 때 만든 데이터베이스 ID로 바꾼다
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
